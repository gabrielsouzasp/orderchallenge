@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<h2>Criar uma nova ordem</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Order.Symbol">Símbolo: </label>

        <select asp-for="Order.Symbol" class="form-select">
            <option value="PETR4">PETR4</option>
            <option value="VALE3">VALE3</option>
            <option value="VIIA4">VIIA4</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="Order.Side">Lado: </label>

        <select asp-for="Order.Side" class="form-select">
            <option value="1">Compra</option>
            <option value="2">Venda</option>
        </select>
    </div>

    <div>
        <label asp-for="Order.Quantity">Quantidade: </label>
        <input asp-for="Order.Quantity" min="1" max="99999" step="1" placeholder="3" type="number" class="form-control" />
        <span asp-validation-for="Order.Quantity" class="text-danger"></span>
    </div>

    <div>
        <label asp-for="Order.Price">Preço: </label>
        <input asp-for="Order.Price" type="number" min="0.01" max="999.99" step="0.01" placeholder="0.00" class="form-control" />
        <span asp-validation-for="Order.Price" class="text-danger"></span>
    </div>

    <br />
    <button type="submit" class="btn btn-primary">
        Criar
    </button>
</form>

@if (!string.IsNullOrEmpty(Model.Message))
{
    var css = Model.Accepted == true ? "alert-success"
            : Model.Accepted == false ? "alert-danger"
            : "alert-warning";
    <div class="alert @css mt-3">@Model.Message</div>
}